# Only PayPal is required. Every other key is optional: missing providers are skipped automatically.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
APP_URL=http://localhost:8000

# Provider order (first = primary). Remove a name to disable it.
PROVIDERS_LLM=claude,openai,gemini,ollama,ollama_docker
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_DOCKER_URL=http://ollama:11434
OLLAMA_MODEL=deephat
# Folder with your local Ollama models (mounted into the container)
OLLAMA_MODELS_DIR=D:/AI/Ollama/models

# Voice (all optional; the browser's own speech engines are the last fallback)
PROVIDERS_STT=deepgram,assemblyai,openai_whisper
PROVIDERS_TTS=elevenlabs,cartesia,openai_tts
PROVIDERS_SMS=twilio,telnyx
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
# Twilio: point your number's Voice webhook at  <APP_URL>/voice/twilio/incoming  (POST)
#         and the status callback at             <APP_URL>/voice/twilio/status
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Telnyx backup number (TeXML app): <APP_URL>/voice/telnyx/incoming
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=

# Money rules (policy engine)
PAYOUT_AUTO_APPROVE_LIMIT=50
PAYOUT_MAX_ITEM=500
PAYOUT_MAX_TOTAL=1000
REFUND_AUTO_LIMIT=20
CREW_SHARE_PCT=10
# Sandbox personal accounts used as crew (comma-separated), seeded on first start
CREW_EMAILS=

# Order workflow timing (seconds)
PAYMENT_TIMEOUT_S=900
REMINDER_WAIT_S=900
FULFIL_SECONDS=20
INTERNAL_API_TOKEN=generate-a-long-random-token-for-temporal-worker

# Infrastructure (docker-compose sets these; fallbacks kick in if unreachable)
DATABASE_URL=postgresql+asyncpg://callpay:callpay@postgres:5432/callpay
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP=kafka:9092
