entrypoint = "replit_start.py"
run = "python3 replit_start.py"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
build = "python3 -m pip install ./services/api && npm --prefix apps/web ci && API_INTERNAL_URL=http://127.0.0.1:8000 NEXT_PUBLIC_API_URL=/api npm --prefix apps/web run build"
run = "python3 replit_start.py"
